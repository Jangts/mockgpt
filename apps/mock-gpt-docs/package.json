{
  "name": "@jangts/mock-gpt-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static reference website for MockGPT",
  "scripts": {
    "dev": "node scripts/generate.mjs && vitepress dev . --host 127.0.0.1",
    "build": "node scripts/generate.mjs && vitepress build .",
    "preview": "vitepress preview . --host 127.0.0.1",
    "check": "node scripts/generate.mjs && node scripts/check.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitepress": "1.6.4",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jangts/mockgpt.git",
    "directory": "apps/mock-gpt-docs"
  },
  "bugs": {
    "url": "https://github.com/Jangts/mockgpt/issues"
  }
}
