{
  "name": "@jangts/mock-gpt",
  "version": "0.3.0",
  "description": "Scenario-driven mock SDK for model APIs, streaming, batches and realtime sessions",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "docs",
    "README.md",
    "examples"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./node": {
      "types": "./dist/esm/node.d.ts",
      "import": "./dist/esm/node.js",
      "require": "./dist/cjs/node.js"
    },
    "./web": {
      "types": "./dist/esm/web.d.ts",
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.js"
    }
  },
  "bin": {
    "mock-gpt": "./bin/mock-gpt.cjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openai": "^7.45.1",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.14",
    "ws": "^8.23.0",
    "@types/ws": "^8.18.2"
  },
  "homepage": "https://mockgpt-docs.pages.jangts.cafe/",
  "keywords": [
    "mockgpt",
    "mock",
    "mocking",
    "llm",
    "ai",
    "testing",
    "test-double",
    "api-mocking",
    "openai-compatible",
    "chat-completions",
    "tool-calling",
    "function-calling",
    "sse",
    "streaming",
    "synthetic-data",
    "typescript",
    "nodejs",
    "browser",
    "responses-api",
    "anthropic",
    "gemini",
    "batch",
    "realtime",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jangts/mockgpt.git",
    "directory": "packages/mock-gpt"
  },
  "bugs": {
    "url": "https://github.com/Jangts/mockgpt/issues"
  }
}
